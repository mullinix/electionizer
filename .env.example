ELECTIONIZER_DB=electionizer.db
ELECTIONIZER_BIND=127.0.0.1:3000
ELECTIONIZER_MODE=both
ELECTIONIZER_PROVIDER=live
ELECTIONIZER_FIXTURE_DIR=testdata
ELECTIONIZER_DAEMON_INTERVAL_SECS=3600
ELECTIONIZER_REFRESH_HOURS=24
ELECTIONIZER_STAGE_DELAY_MS=400
ELECTIONIZER_FEC_API_KEY=DEMO_KEY
ELECTIONIZER_CYCLE=2026
# Set to 1 to keep electionizer.db across cargo builds
# Or wipe at process start: cargo run -- --fresh
RUST_LOG=info
