:"en"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P854","P1683"]}]},{"mainsnak":{"snaktype":"value","property":"P108","hash":"cc8322c328010d15cb145bc4074252b053fe6b7f","datavalue":{"value":{"entity-type":"item","numeric-id":4938304,"id":"Q4938304"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","qualifiers":{"P580":[{"snaktype":"value","property":"P580","hash":"8752b82cdffad4bcee274913d130a05ca27d08b0","datavalue":{"value":{"time":"+2001-00-00T00:00:00Z","timezone":0,"before":0,"after":0,"precision":9,"calendarmodel":"http://www.wikidata.org/entity/Q1985727"},"type":"time"},"datatype":"time"}],"P582":[{"snaktype":"value","property":"P582","hash":"873637ae7f17bb28f5dd557da137f00256d6f77e","datavalue":{"value":{"time":"+2005-00-00T00:00:00Z","timezone":0,"before":0,"after":0,"precision":9,"calendarmodel":"http://www.wikidata.org/entity/Q1985727"},"type":"time"},"datatype":"time"}]},"qualifiers-order":["P580","P582"],"id":"Q22222$39d621aa-4c52-0931-c759-47b68b51fc7f","rank":"normal","references":[{"hash":"169fe7fe9bc93801dea3ed311073b54bfa5ee5ed","snaks":{"P248":[{"snaktype":"value","property":"P248","hash":"9a90a47c48e33c4b8dd016dac76865ba9d6f10d1","datavalue":{"value":{"entity-type":"item","numeric-id":123002363,"id":"Q123002363"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P854":[{"snaktype":"value","property":"P854","hash":"e0faf65830b2cf15f418d54c5e5776f5da18b3ac","datavalue":{"value":"https://www.nytimes.com/2009/03/27/nyregion/27gillibrand.html","type":"string"},"datatype":"url"}],"P1683":[{"snaktype":"value","property":"P1683","hash":"46a550949534a577ed97bafe71362e73c307eee1","datavalue":{"value":{"text":"When she moved in 2001 to a new firm, Boies Schiller, where she worked until 2005, one of Ms. Gillibrand\u2019s clients was the Altria Group, Philip Morris\u2019s parent company, where she helped with securities and antitrust matters, according to the firm.","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P854","P1683"]}]}]}}