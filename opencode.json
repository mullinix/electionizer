{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["HANDOFF.md", "README.md"],
  "lsp": {
    "rust": {
      "command": ["{env:HOME}/.cargo/bin/rust-analyzer"],
      "extensions": [".rs"],
      "initialization": {
        "cargo": {
          "buildScripts": { "enable": true }
        },
        "procMacro": { "enable": true }
      }
    },
    "typescript": {
      "command": [
        "node",
        "./node_modules/typescript-language-server/lib/cli.mjs",
        "--stdio"
      ],
      "extensions": [".js", ".mjs", ".cjs"],
      "initialization": {
        "preferences": {
          "includeInlayParameterNameHints": "none"
        }
      }
    },
    "deno": { "disabled": true },
    "eslint": { "disabled": true },
    "oxlint": { "disabled": true }
  },
  "permission": {
    "lsp": "allow"
  },
  "mcp": {
    "electionizer": {
      "type": "local",
      "command": ["node", "mcp/electionizer/server.js"],
      "enabled": true,
      "timeout": 600000
    }
  }
}
